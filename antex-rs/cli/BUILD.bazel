load("//:defs.bzl", "antex_rust_crate")
load("//bazel/platforms:release_binaries.bzl", "multiplatform_binaries")
load("//bazel/rules:e2e_benchmark.bzl", "antex_e2e_benchmark")
load("//bazel/rules:runtime_package.bzl", "release_binary")

antex_rust_crate(
    name = "cli",
    binaries_with_build_commit = ["antex"],
    crate_name = "antex_cli",
    extra_binaries = [
        "//antex-rs/bwrap:bwrap",
    ],
    test_data_extra = glob(["src/**/snapshots/**"]),
)

release_binary(
    binary = ":antex",
)

multiplatform_binaries(
    name = "antex",
)

antex_e2e_benchmark(
    name = "antex-help",
    binaries = [":antex"],
)
